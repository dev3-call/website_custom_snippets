<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="s_brands_marquee" name="Brands Marquee">
        <section class="s_brands_marquee o_not_editable" contenteditable="false">
            <div class="container">
                <div class="brands-marquee-wrapper">

                    <h4 class="s_brands_marquee_title d-none" contenteditable="true">Brands</h4>

                    <div class="brands-marquee">
                        <div class="brands-track">

                            <a href="#" class="s_brands_item" target="_blank" data-brand-id="brand_1">
                                <img class="brand_img"
                                     src="https://dummyimage.com/220x110/000/fff.png&amp;text=Brand+1"
                                     alt="Brand 1"/>
                            </a>

                            <a href="#" class="s_brands_item" target="_blank" data-brand-id="brand_2">
                                <img class="brand_img"
                                     src="https://dummyimage.com/220x110/000/fff.png&amp;text=Brand+2"
                                     alt="Brand 2"/>
                            </a>

                        </div>
                    </div>

                </div>
            </div>
        </section>
    </template>


    <template id="s_brands_marquee_options" inherit_id="website.snippet_options">
        <xpath expr="." position="inside">
            <div data-js="BrandsMarquee" data-selector=".s_brands_marquee">
                <t t-set="add_item_title">Add New Brand Image</t>

                <we-list string="Brands"
                         t-att-data-add-item-title="add_item_title"
                         data-render-list-items=""
                         data-has-default="multiple"
                         data-name="brands_marquee_list"
                         data-default-value="https://dummyimage.com/220x110/000/fff.png&amp;text=NEW+BRAND"
                         data-id-mode="id"
                         data-new-elements-not-toggleable="true"
                         data-no-preview="true"/>
            </div>
        </xpath>
    </template>

</odoo>
