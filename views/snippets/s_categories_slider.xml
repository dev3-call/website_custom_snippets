<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="s_categories_slider" name="Categories Slider">
        <section class="s_categories_slider categories-slider o_cc o_cc1">
            <div class="container">
                <!-- ✅ oe_structure para permitir contenido editable -->
                <div class="slider-container oe_structure" aria-label="Categories slider">

                    <!-- Card base (se puede duplicar o crear desde opción) -->
                    <a class="card" href="#">
                        <!-- ✅ Background editable -->
                        <img class="card-bg o_editable_media"
                            src="/web/static/img/placeholder.png"
                            alt="Background"/>

                        <div class="card-overlay"></div>

                        <div class="content">
                            <img src="/website_custom_snippets/static/src/img/icons/ceramica.svg"
                                alt="Icon"
                                class="icon o_editable_media"/>

                            <!-- ✅ Nombre editable -->
                            <h3 class="o_default_snippet_text">Nueva Categoría</h3>
                        </div>
                    </a>

                </div>

                <div class="dots" aria-label="Slider pagination"></div>
            </div>
        </section>
    </template>

</odoo>
