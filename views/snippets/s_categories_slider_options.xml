<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="s_categories_slider_options" inherit_id="website.snippet_options">
    <xpath expr="." position="inside">

      <div data-js="MultipleItems" data-selector=".s_categories_slider">

        <we-row string="Tarjetas">
          <we-button data-add-item=""
                     data-item=".slider-container > .card:last"
                     data-select-item=""
                     data-no-preview="true"
                     class="o_we_bg_brand_primary">
              + Agregar tarjeta
          </we-button>

          <we-button data-remove-item=""
                     data-item=".slider-container > .card:last"
                     data-no-preview="true"
                     class="o_we_bg_brand_secondary">
              Eliminar última
          </we-button>
        </we-row>

      </div>

    </xpath>
  </template>

</odoo>
